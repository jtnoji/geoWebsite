# Supply-chain guards. This is the highest-likelihood attack path in the
# project: every npm incident of 2025-2026 (Shai-Hulud and its 2.0 wave,
# chalk/debug, the TanStack worm, Miasma) executed on a build machine or a
# developer laptop, not in a visitor's browser.

# 1. Do not run pre/post-install hooks. That is how nearly every recent worm
#    executed. Verified 2026-07-25 that `npm ci && npm run build` succeeds with
#    this set: the only two packages carrying install scripts are `sharp`
#    (unused here — next.config.ts sets images.unoptimized and no next/image
#    output exists) and `unrs-resolver` (eslint-plugin-import, dev only, ships
#    platform-specific optional deps that resolve without the hook).
#    If a future dependency genuinely needs its hook, allow just that one with
#    `npm rebuild <pkg>` rather than removing this line.
ignore-scripts=true

# 2. Refuse versions published in the last 3 days. Malicious releases are
#    typically yanked within hours, so a cooldown means we never install them
#    rather than installing and then scrambling to respond.
min-release-age=4320

# 3. Lockfile is authoritative; never silently resolve a new version.
save-exact=true
